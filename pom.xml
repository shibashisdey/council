<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot Parent -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version>
		<relativePath/>
	</parent>

	<groupId>com.council</groupId>
	<artifactId>council</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>council</name>
	<description>Main project for Council application</description>

	<!-- Modules -->
	<modules>
		<module>eureka-server</module>
		<module>api-gateway</module>
		<module>user-authentication-service</module>
		<module>counselor-service</module>
		<module>appointment-service</module>
		<module>review-service</module>
		<module>notification-service</module>
		<module>payment-service</module>
		<module>product-webapp</module>
		<module>user-service</module>
		<module>availability-service</module>
	</modules>

	<!-- Global properties -->
	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- Dependency version management ONLY -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2023.0.1</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
